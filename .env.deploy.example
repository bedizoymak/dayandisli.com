# Copy this file to .env.deploy.local and fill in the real values.
# .env.deploy.local is ignored by git and must never be committed.
DAYAN_FTP_HOST=
DAYAN_FTP_USER=
DAYAN_FTP_PASS=
DAYAN_FTP_PORT=21

# This hosting account is jailed directly to the web document root.
# Combined dist/ must therefore deploy to / so dist/erp becomes /erp.
DAYAN_FTP_REMOTE_ROOT=/
